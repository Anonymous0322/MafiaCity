# =============================================================================
# 1. Telegram bot (@BotFather)
# =============================================================================
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_BOT_USERNAME=mafiauz_robot
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=mafiauz_robot

# =============================================================================
# 2. Session secret (at least 32 random characters)
# =============================================================================
SESSION_SECRET=your_session_secret_here

# =============================================================================
# 3. Supabase — the persistent store for players, lobbies, matches and stats
# =============================================================================
# Server-side connection (never expose the secret key to the browser).
SUPABASE_URL=https://your-project.supabase.co

# Server-only secret key. Required at runtime: every table is behind RLS, so the
# publishable key cannot read or write any row.
#   Supabase dashboard -> Project Settings -> API Keys -> "service_role" / secret
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Publishable (anon) key. Safe to expose; used only by the browser for the
# Realtime push channel. It has no access to any table.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# =============================================================================
# 4. Database migrations (needed only for `npm run db:migrate`)
# =============================================================================
# Either a full connection string ...
# DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
# ... or just the project database password (SUPABASE_URL must also be set).
# SUPABASE_DB_PASSWORD=your_database_password

# =============================================================================
# 5. WebApp URL (deployed address)
# =============================================================================
WEBAPP_URL=https://your-app.vercel.app
NEXT_PUBLIC_WEBAPP_URL=https://your-app.vercel.app
