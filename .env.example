# 1. Telegram Bot Token (@BotFather dan olinadi)
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_BOT_USERNAME=mafiauz_robot
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=mafiauz_robot

# 2. Sessiya maxfiy kaliti (kamida 32 belgili tasodifiy satr)
SESSION_SECRET=your_session_secret_here

# 3. Supabase (ixtiyoriy — hozircha kod faqat in-memory store ishlatadi)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# 4. WebApp URL (deploy qilingan manzil)
WEBAPP_URL=https://your-app.vercel.app
NEXT_PUBLIC_WEBAPP_URL=https://your-app.vercel.app